#!/bin/bash

# Остановка при ошибках, неинициализированных переменных и ошибках в конвейерах (pipe)
set -euo pipefail
set -x

# ====================================================================
# КОНФИГУРАЦИЯ СБОРКИ
# ====================================================================

# Kernel Source
KERNEL_SOURCE="https://github.com/StimLuks87/android_kernel_realme_salaa"
KERNEL_BRANCH="16QPR2"
KERNEL_DEFCONFIG="salaa_defconfig"
HOSTCC_CMD="ccache clang"
HOSTCXX_CMD="ccache clang++"

# Clang Toolchain (ZYC Clang / LLVM)
CLANG_GITLAB="https://gitlab.com/clangsantoni/zyc_clang.git"
CLANG_BRANCH="20"

# Пути
WORK="/home/runner/work"
KERNEL="myKernel"
KERNEL_SRC="${WORK}/${KERNEL}"

# ====================================================================
# НАСТРОЙКА CCACHE
# ====================================================================
export USE_CCACHE=1
export CCACHE_DIR="${WORK}/.ccache"
export CCACHE_EXEC=$(which ccache || echo "/usr/bin/ccache")
export CCACHE_COMPILERCHECK=content
export CCACHE_MAXSIZE="5G"

# Функция вызова make с флагами LLVM и ccache
make_fun() {
	make O=out ARCH=arm64 \
		CC="ccache clang" \
        HOSTCC="$HOSTCC_CMD" \
        HOSTCXX="$HOSTCXX_CMD" \
		LLVM=1 \
		CROSS_COMPILE=aarch64-linux-gnu- \
		CROSS_COMPILE_COMPAT=arm-linux-gnueabi- "$@"
}

# ====================================================================
# ПОДГОТОВКА ОКРУЖЕНИЯ
# ====================================================================
mkdir -p "${WORK}" "${CCACHE_DIR}"
cd "${WORK}"

# Быстрое клонирование тулчейна Clang
if [ ! -d clang ]; then
	git clone --depth=1 --single-branch -b "${CLANG_BRANCH}" "${CLANG_GITLAB}" ./clang
fi

# Клонирование исходников ядра
if [ ! -d "${KERNEL}" ]; then
	git clone --depth=1 --single-branch -b "${KERNEL_BRANCH}" "${KERNEL_SOURCE}" "${KERNEL}"
fi

# Настройка PATH (Clang бинарники первыми)
PATH="${WORK}/clang/bin:${PATH}"

# Переходим в корень исходников ядра
cd "${KERNEL_SRC}"

# Настройка и обнуление статистики ccache перед сборкой
ccache -M 5G
ccache -z

# ====================================================================
# СБОРКА ЯДРА
# ====================================================================
make_fun "${KERNEL_DEFCONFIG}"
make_fun -j"$(nproc --all)" 2>&1 | tee build.log

# Вывод статистики ccache после сборки
ccache -s

# ====================================================================
# УПАКОВКА В ANYKERNEL3
# ====================================================================
DATE_NOW=$(date +%Y%m%d-%H%M)
TARGET_IMAGE="${KERNEL_SRC}/out/arch/arm64/boot/Image.gz"

if [ -f "${TARGET_IMAGE}" ]; then
    echo "=== Ядро успешно собрано! Начинаем упаковку в AnyKernel... ==="
    
    # Очистка и клонирование AnyKernel3
    rm -rf "${WORK}/AnyKernel"
    git clone --depth=1 https://github.com/Luks-organization/AnyKernel3.git "${WORK}/AnyKernel"
    
    # Копирование собранного ядра
    cp "${TARGET_IMAGE}" "${WORK}/AnyKernel/"
    
    # Создание ZIP архива
    cd "${WORK}/AnyKernel"
    zip -r9 "${WORK}/Bolt-ZAP-salaa-${DATE_NOW}.zip" ./* -x "*.git*" "README.md"
    
    echo "=== Сборка AnyKernel завершена! Архив: ${WORK}/Bolt-ZAP-salaa-${DATE_NOW}.zip ==="
else
    echo "Ошибка: Файл Image.gz не найден. Компиляция завершилась с ошибкой."
    exit 1
fi
